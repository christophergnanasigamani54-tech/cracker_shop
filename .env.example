# Copy this file to .env for local startup.
# Set secrets in hosting environment variables when deployed.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/crackers_shop
PORT=5280
HOST=127.0.0.1

# Gmail SMTP sends OTP email to customers' email addresses. Use a Google App Password,
# not the Gmail account password. When SMTP_HOST is set, SMTP is chosen over Resend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
EMAIL_FROM=your-email@gmail.com

# Optional alternative provider; used only when SMTP_HOST is not set.
RESEND_API_KEY=

# Required only for admin password recovery
PUBLIC_BASE_URL=https://your-railway-app.up.railway.app
