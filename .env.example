# Reference only: the app does not load this file automatically.
# Set these variables in the hosting dashboard, or in your shell.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/crackers_shop
PORT=5280
HOST=127.0.0.1

# Required for customer account email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Required only for admin password recovery
PUBLIC_BASE_URL=https://your-railway-app.up.railway.app
